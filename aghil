#!/usr/bin/env bash

APP="Aghil Terminal Helper"
VERSION="2.0.0"

RESET='\033[0m'
CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
BLUE='\033[1;34m'
MAGENTA='\033[1;35m'
WHITE='\033[1;37m'
GRAY='\033[0;37m'

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

pause() {
    echo
    read -r -p "↩ Enter برای ادامه..." _
}

banner() {
    clear
    echo -e "${CYAN}"
    echo "╔══════════════════════════════════════════════╗"
    echo "║                                              ║"
    echo "║        🚀 AGHIL TERMINAL HELPER V2          ║"
    echo "║                                              ║"
    echo "║       Linux • Termux • Git • Python          ║"
    echo "║                                              ║"
    echo "╚══════════════════════════════════════════════╝"
    echo -e "${RESET}"
    echo -e "${GRAY}کاربر: ${WHITE}$USER${RESET}"
    echo -e "${GRAY}مسیر:  ${WHITE}$PWD${RESET}"
    echo
}

success() {
    echo -e "${GREEN}✅ $1${RESET}"
}

error_msg() {
    echo -e "${RED}❌ $1${RESET}"
}

info() {
    echo -e "${CYAN}ℹ️ $1${RESET}"
}

suggest() {
    echo
    echo -e "${MAGENTA}╭─ 💡 پیشنهاد مرحله بعد ─────────────────────╮${RESET}"
    echo -e "${WHITE}│ $1${RESET}"
    echo -e "${MAGENTA}╰─────────────────────────────────────────────╯${RESET}"
}

ask() {
    local text="$1"
    local value
    read -r -p "$text" value
    printf '%s' "$value"
}

execute() {
    local label="$1"
    shift

    echo
    echo -e "${YELLOW}▶ $label${RESET}"
    echo -e "${GRAY}────────────────────────────────────────────${RESET}"

    "$@"
    local rc=$?

    echo

    if [ "$rc" -eq 0 ]; then
        success "عملیات با موفقیت انجام شد."
    else
        error_msg "عملیات ناموفق بود. کد خطا: $rc"
    fi

    return "$rc"
}

package_manager() {

    if command_exists pkg; then
        echo "pkg"
    elif command_exists apt; then
        echo "apt"
    elif command_exists dnf; then
        echo "dnf"
    elif command_exists pacman; then
        echo "pacman"
    else
        echo ""
    fi
}

install_package() {

    local p="$1"
    local pm
    pm="$(package_manager)"

    [ -z "$pm" ] && {
        error_msg "Package Manager پیدا نشد."
        return 1
    }

    case "$pm" in
        pkg)
            execute "نصب $p" pkg install "$p"
            ;;
        apt)
            if [ "$(id -u)" -eq 0 ]; then
                execute "نصب $p" apt install -y "$p"
            elif command_exists sudo; then
                execute "نصب $p" sudo apt install -y "$p"
            else
                error_msg "sudo موجود نیست."
            fi
            ;;
        dnf)
            execute "نصب $p" sudo dnf install -y "$p"
            ;;
        pacman)
            execute "نصب $p" sudo pacman -S --noconfirm "$p"
            ;;
    esac
}

package_menu() {

    while true; do

        banner

        echo -e "${BLUE}📦 PACKAGE MANAGER${RESET}"
        echo
        echo "1) 🔄 Update"
        echo "2) ⬆️ Upgrade"
        echo "3) 📥 Install"
        echo "4) 🗑️ Remove"
        echo "5) 🔎 Search"
        echo "6) 📋 Installed"
        echo "0) ↩ برگشت"
        echo

        read -r -p "انتخاب: " x

        local pm
        pm="$(package_manager)"

        case "$x" in

        1)
            case "$pm" in
                pkg) execute "Update" pkg update ;;
                apt) execute "Update" sudo apt update ;;
                dnf) execute "Update" sudo dnf check-update ;;
                pacman) execute "Update" sudo pacman -Sy ;;
            esac
            pause
            ;;

        2)
            case "$pm" in
                pkg) execute "Upgrade" pkg upgrade ;;
                apt) execute "Upgrade" sudo apt upgrade -y ;;
                dnf) execute "Upgrade" sudo dnf upgrade -y ;;
                pacman) execute "Upgrade" sudo pacman -Syu ;;
            esac
            pause
            ;;

        3)
            p="$(ask 'نام پکیج: ')"
            [ -n "$p" ] && install_package "$p"
            pause
            ;;

        4)
            p="$(ask 'نام پکیج: ')"

            case "$pm" in
                pkg) execute "Remove" pkg uninstall "$p" ;;
                apt) execute "Remove" sudo apt remove -y "$p" ;;
                dnf) execute "Remove" sudo dnf remove -y "$p" ;;
                pacman) execute "Remove" sudo pacman -R --noconfirm "$p" ;;
            esac

            pause
            ;;

        5)
            p="$(ask 'عبارت جستجو: ')"

            case "$pm" in
                pkg) pkg search "$p" ;;
                apt) apt search "$p" ;;
                dnf) dnf search "$p" ;;
                pacman) pacman -Ss "$p" ;;
            esac

            pause
            ;;

        6)
            case "$pm" in
                pkg) pkg list-installed ;;
                apt) apt list --installed 2>/dev/null ;;
                dnf) dnf list installed ;;
                pacman) pacman -Q ;;
            esac

            pause
            ;;

        0)
            return
            ;;

        esac

    done
}

files_menu() {

    while true; do

        banner

        echo -e "${BLUE}📁 FILE MANAGER${RESET}"
        echo
        echo "1) 📋 List"
        echo "2) 📂 Create folder"
        echo "3) 📄 Create file"
        echo "4) ✏️ Rename"
        echo "5) 🗑️ Delete"
        echo "6) 📍 Current path"
        echo "7) 🚪 Enter folder"
        echo "8) 🔍 Find file"
        echo "0) ↩ برگشت"
        echo

        read -r -p "انتخاب: " x

        case "$x" in

        1)
            ls -lah
            pause
            ;;

        2)
            p="$(ask 'نام پوشه: ')"

            if [ -n "$p" ]; then
                mkdir -p -- "$p"
                success "پوشه ساخته شد."
            fi

            pause
            ;;

        3)
            p="$(ask 'نام فایل: ')"

            if [ -n "$p" ]; then
                touch -- "$p"
                success "فایل ساخته شد."
            fi

            pause
            ;;

        4)
            old="$(ask 'نام فعلی: ')"
            new="$(ask 'نام جدید: ')"

            if [ -e "$old" ]; then
                mv -- "$old" "$new"
                success "نام تغییر کرد."
            else
                error_msg "فایل یا پوشه پیدا نشد."
            fi

            pause
            ;;

        5)
            target="$(ask 'مسیر فایل/پوشه: ')"

            if [ -e "$target" ]; then

                echo -e "${RED}⚠️ حذف دائمی است.${RESET}"
                read -r -p "برای تأیید DELETE بنویس: " ok

                if [ "$ok" = "DELETE" ]; then
                    rm -rf -- "$target"
                    success "حذف شد."
                fi

            else
                error_msg "مورد پیدا نشد."
            fi

            pause
            ;;

        6)
            pwd
            pause
            ;;

        7)
            p="$(ask 'مسیر: ')"

            if [ -d "$p" ]; then
                cd -- "$p"
            else
                error_msg "پوشه پیدا نشد."
                pause
            fi
            ;;

        8)
            p="$(ask 'نام فایل: ')"
            find . -iname "*$p*" 2>/dev/null | head -50
            pause
            ;;

        0)
            return
            ;;

        esac

    done
}

git_menu() {

    while true; do

        banner

        echo -e "${BLUE}🐙 GIT / GITHUB${RESET}"
        echo
        echo "1) 📥 Clone"
        echo "2) 🆕 Init"
        echo "3) 📊 Status"
        echo "4) ➕ Add"
        echo "5) 💾 Commit"
        echo "6) 🚀 Push"
        echo "7) ⬇️ Pull"
        echo "8) 🌿 Branches"
        echo "9) 🔀 Switch branch"
        echo "10) 🔗 Remote"
        echo "11) 📜 Log"
        echo "0) ↩ برگشت"
        echo

        read -r -p "انتخاب: " x

        case "$x" in

        1)
            url="$(ask 'GitHub URL: ')"

            if [ -n "$url" ]; then
                git clone "$url"
                suggest "cd نام-پوشه"
            fi

            pause
            ;;

        2)
            git init
            success "Git repository ساخته شد."
            suggest "git status"
            pause
            ;;

        3)
            git status
            suggest "git add ."
            pause
            ;;

        4)
            git add .
            success "فایل‌ها به Stage اضافه شدند."
            suggest "git commit"
            pause
            ;;

        5)
            msg="$(ask 'Commit message: ')"

            if [ -n "$msg" ]; then
                git add .
                git commit -m "$msg"
                suggest "git push"
            fi

            pause
            ;;

        6)
            git push
            pause
            ;;

        7)
            git pull
            pause
            ;;

        8)
            git branch -a
            pause
            ;;

        9)
            branch="$(ask 'نام Branch: ')"

            if [ -n "$branch" ]; then
                git switch "$branch" 2>/dev/null ||
                git switch -c "$branch"
            fi

            pause
            ;;

        10)
            git remote -v
            pause
            ;;

        11)
            git log --oneline --decorate --graph -20
            pause
            ;;

        0)
            return
            ;;

        esac

    done
}

python_menu() {

    local py="python"

    command_exists python3 && py="python3"

    while true; do

        banner

        echo -e "${BLUE}🐍 PYTHON${RESET}"
        echo
        echo "1) Version"
        echo "2) Install Package"
        echo "3) Run Python file"
        echo "4) Create venv"
        echo "5) requirements.txt"
        echo "6) pip list"
        echo "7) Create Python project"
        echo "0) برگشت"
        echo

        read -r -p "انتخاب: " x

        case "$x" in

        1)
            "$py" --version
            pause
            ;;

        2)
            p="$(ask 'Package: ')"
            [ -n "$p" ] && "$py" -m pip install "$p"
            suggest "$py -m pip list"
            pause
            ;;

        3)
            f="$(ask 'فایل Python: ')"

            if [ -f "$f" ]; then
                "$py" "$f"
            else
                error_msg "فایل پیدا نشد."
            fi

            pause
            ;;

        4)
            name="$(ask 'نام venv: ')"

            if [ -n "$name" ]; then
                "$py" -m venv "$name"
                suggest "source $name/bin/activate"
            fi

            pause
            ;;

        5)
            "$py" -m pip install -r requirements.txt
            pause
            ;;

        6)
            "$py" -m pip list
            pause
            ;;

        7)
            name="$(ask 'نام پروژه: ')"

            if [ -n "$name" ]; then

                mkdir -p "$name"
                touch "$name/main.py"
                touch "$name/README.md"
                touch "$name/requirements.txt"

                success "پروژه Python ساخته شد."
                suggest "cd $name && $py main.py"

            fi

            pause
            ;;

        0)
            return
            ;;

        esac

    done
}

system_menu() {

    while true; do

        banner

        echo -e "${BLUE}⚙️ SYSTEM${RESET}"
        echo
        echo "1) 💾 Disk"
        echo "2) 🧠 RAM"
        echo "3) 🖥️ System info"
        echo "4) 🔥 Processes"
        echo "5) 🌐 Network"
        echo "6) ⏱️ Uptime"
        echo "7) 👤 User"
        echo "0) ↩ برگشت"
        echo

        read -r -p "انتخاب: " x

        case "$x" in

        1)
            df -h
            pause
            ;;

        2)
            if command_exists free; then
                free -h
            else
                grep -E "MemTotal|MemAvailable" /proc/meminfo
            fi
            pause
            ;;

        3)
            uname -a
            echo
            [ -f /etc/os-release ] && cat /etc/os-release
            pause
            ;;

        4)
            ps aux | head -30
            pause
            ;;

        5)
            if command_exists ip; then
                ip addr
            else
                ifconfig
            fi
            pause
            ;;

        6)
            uptime
            pause
            ;;

        7)
            id
            whoami
            pause
            ;;

        0)
            return
            ;;

        esac

    done
}

quick_commands() {

    while true; do

        banner

        echo -e "${BLUE}⚡ QUICK COMMAND${RESET}"
        echo
        echo "دستور را وارد کن."
        echo "Aghil آن را اجرا می‌کند و مرحله بعد را پیشنهاد می‌دهد."
        echo
        echo "مثال:"
        echo "  git status"
        echo "  ls"
        echo "  pwd"
        echo "  python --version"
        echo
        echo "برای خروج: exit"
        echo

        read -r -p "aghil> " cmd

        [ "$cmd" = "exit" ] && return
        [ -z "$cmd" ] && continue

        echo
        eval "$cmd"
        rc=$?

        if [ "$rc" -eq 0 ]; then

            case "$cmd" in

            "git status")
                suggest "git add ."
                ;;

            "git add ."*)
                suggest "git commit -m \"update\""
                ;;

            "git commit"*)
                suggest "git push"
                ;;

            "git clone"*)
                suggest "cd نام-پوشه"
                ;;

            "python"*|"python3"*)
                suggest "python -m pip list"
                ;;

            "ls"*)
                suggest "cd نام-پوشه"
                ;;

            "mkdir"*)
                suggest "cd نام-پوشه"
                ;;

            "pwd")
                suggest "ls -lah"
                ;;

            "cd"*)
                suggest "ls -lah"
                ;;

            *)
                suggest "برای راهنمای دستور، گزینه Help را استفاده کن."
                ;;

            esac

        else
            error_msg "دستور با خطا اجرا شد."
        fi

        echo
        read -r -p "Enter برای ادامه..." _
    done
}

command_search() {

    banner

    q="$(ask '🔎 دستور موردنظر: ')"

    echo

    if command_exists apropos; then
        apropos "$q" 2>/dev/null | head -30
    fi

    echo
    echo "دستورهای مشابه:"
    compgen -c 2>/dev/null |
        grep -i -- "$q" |
        sort -u |
        head -30

    pause
}

command_help() {

    banner

    q="$(ask '❓ نام دستور: ')"

    echo

    if command_exists man; then
        man "$q"
    elif command_exists "$q"; then
        "$q" --help
    else
        error_msg "دستور پیدا نشد."
        pause
    fi
}

script_runner() {

    banner

    file="$(ask '🔧 مسیر Script: ')"

    if [ ! -f "$file" ]; then
        error_msg "فایل پیدا نشد."
        pause
        return
    fi

    case "$file" in
        *.sh)
            chmod +x "$file"
            bash "$file"
            ;;
        *)
            error_msg "فقط فایل .sh مجاز است."
            ;;
    esac

    pause
}

project_creator() {

    banner

    echo -e "${BLUE}🏗️ PROJECT CREATOR${RESET}"
    echo
    echo "1) Bash"
    echo "2) Python"
    echo "3) Web"
    echo "0) برگشت"
    echo

    read -r -p "انتخاب: " x

    name="$(ask 'نام پروژه: ')"

    [ -z "$name" ] && return

    case "$x" in

    1)
        mkdir -p "$name"
        printf '#!/usr/bin/env bash\n\necho "Hello from Aghil Project"\n' > "$name/main.sh"
        chmod +x "$name/main.sh"
        printf '# Bash Project\n' > "$name/README.md"

        success "پروژه Bash ساخته شد."
        suggest "cd $name && ./main.sh"
        ;;

    2)
        mkdir -p "$name"
        printf 'print("Hello from Aghil Project")\n' > "$name/main.py"
        touch "$name/requirements.txt"
        printf '# Python Project\n' > "$name/README.md"

        success "پروژه Python ساخته شد."
        suggest "cd $name && python main.py"
        ;;

    3)
        mkdir -p "$name"
        cat > "$name/index.html" <<'EOF'
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Aghil Project</title>
<style>
body{
    margin:0;
    min-height:100vh;
    display:grid;
    place-items:center;
    background:#0b1020;
    color:white;
    font-family:Tahoma,Arial;
}
.card{
    padding:40px;
    border-radius:20px;
    background:#111827;
    text-align:center;
}
</style>
</head>
<body>
<div class="card">
<h1>🚀 پروژه Aghil</h1>
<p>شروع شد!</p>
</div>
</body>
</html>
EOF

        success "پروژه Web ساخته شد."
        suggest "cd $name && ls -lah"
        ;;

    esac

    pause
}

main() {

    while true; do

        banner

        echo -e "${WHITE}منوی اصلی${RESET}"
        echo
        echo "1) 📁 File Manager"
        echo "2) 📦 Package Manager"
        echo "3) 🐙 Git / GitHub"
        echo "4) 🐍 Python"
        echo "5) ⚙️ System"
        echo "6) 🔧 Run Script"
        echo "7) ⚡ Quick Command"
        echo "8) 🏗️ Project Creator"
        echo "9) 🔎 Command Search"
        echo "10) ❓ Command Help"
        echo "0) 🚪 Exit"
        echo

        read -r -p "aghil-v2 > " x

        case "$x" in
            1) files_menu ;;
            2) package_menu ;;
            3) git_menu ;;
            4) python_menu ;;
            5) system_menu ;;
            6) script_runner ;;
            7) quick_commands ;;
            8) project_creator ;;
            9) command_search ;;
            10) command_help ;;
            0)
                clear
                echo "👋 Aghil Terminal Helper V2"
                exit 0
                ;;
        esac

    done
}

main
