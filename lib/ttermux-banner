#!/data/data/com.termux/files/usr/bin/bash
set -u

name="${TTERMUX_NAME:-${USER:-Termux}}"
width="$(tput cols 2>/dev/null || echo 80)"
(( width < 40 )) && width=40
(( width > 100 )) && width=100

printf '\033[2J\033[H'
printf '\033[1;35m'
printf '╭%*s╮\n' "$((width-2))" '' | tr ' ' '─'
printf '│%*s│\n' "$((width-2))" '' | tr ' ' ' '
printf '\033[1;36m'
if command -v figlet >/dev/null 2>&1; then
  figlet -f standard -w "$width" "T-Termux" 2>/dev/null | head -n 6
else
  printf '                 T-Termux\n'
fi
printf '\033[1;35m'
printf '│%*s│\n' "$((width-2))" '' | tr ' ' ' '
printf '╰%*s╯\n' "$((width-2))" '' | tr ' ' '─'
printf '\033[0m'
printf '\033[1;32m  v2.0.0\033[0m  •  \033[1;33m%s\033[0m\n\n' "$name"
