#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail

BASE="$HOME/.t-termux"
BACKUP="$BASE/backups"
ZSHRC="$HOME/.zshrc"

cyan='\033[1;36m'; green='\033[1;32m'; yellow='\033[1;33m'; red='\033[1;31m'; reset='\033[0m'
say(){ printf "${cyan}%s${reset}\n" "$*"; }
ok(){ printf "${green}✓ %s${reset}\n" "$*"; }
warn(){ printf "${yellow}! %s${reset}\n" "$*"; }

doctor() {
  echo "T-Termux v2 Doctor"
  echo "------------------"
  for x in pkg git zsh figlet; do
    if command -v "$x" >/dev/null 2>&1; then ok "$x: OK"; else warn "$x: missing"; fi
  done
  [[ -d "$BASE/plugins/zsh-autosuggestions" ]] && ok "autosuggestions: OK" || warn "autosuggestions: missing"
  [[ -d "$BASE/plugins/zsh-syntax-highlighting" ]] && ok "syntax-highlighting: OK" || warn "syntax-highlighting: missing"
  echo "TERMUX_VERSION=${TERMUX_VERSION:-unknown}"
  echo "PREFIX=${PREFIX:-unknown}"
}

backup() {
  mkdir -p "$BACKUP"
  local stamp="$(date +%Y%m%d-%H%M%S)"
  [[ -f "$ZSHRC" ]] && cp "$ZSHRC" "$BACKUP/zshrc.$stamp.bak"
  ok "نسخه پشتیبان ساخته شد."
}

restore() {
  local latest
  latest=$(ls -1t "$BACKUP"/zshrc.*.bak 2>/dev/null | head -n1 || true)
  [[ -n "$latest" ]] || { warn "هیچ بکاپی پیدا نشد."; return; }
  cp "$latest" "$ZSHRC"
  ok "بازیابی شد: $latest"
}

uninstall() {
  backup
  rm -rf "$BASE"
  if [[ -f "$ZSHRC" ]]; then
    sed -i '/# T-Termux v2 managed block/,/# End T-Termux v2 managed block/d' "$ZSHRC" || true
  fi
  ok "T-Termux حذف شد. بکاپ‌ها در HOME باقی می‌مانند."
}

update_plugins() {
  for d in "$BASE/plugins"/*/.git; do
    [[ -d "$d" ]] || continue
    git -C "${d%/.git}" pull --ff-only || warn "به‌روزرسانی انجام نشد: ${d%/.git}"
  done
  ok "پلاگین‌ها بررسی شدند."
}

menu() {
  while true; do
    clear
    printf "${cyan}╔══════════════════════════════════╗${reset}\n"
    printf "${cyan}║        T-Termux Manager v2       ║${reset}\n"
    printf "${cyan}╚══════════════════════════════════╝${reset}\n\n"
    printf "  ${green}1${reset}) وضعیت سیستم\n"
    printf "  ${green}2${reset}) Doctor\n"
    printf "  ${green}3${reset}) Backup\n"
    printf "  ${green}4${reset}) Restore\n"
    printf "  ${green}5${reset}) Update plugins\n"
    printf "  ${green}6${reset}) ورود به Zsh\n"
    printf "  ${red}7${reset}) حذف T-Termux\n"
    printf "  ${yellow}0${reset}) خروج\n\n"
    read -r "choice?انتخاب: "
    case "$choice" in
      1) clear; uname -a; echo; termux-info 2>/dev/null || true; read -r -p "Enter..." ;;
      2) clear; doctor; read -r -p "Enter..." ;;
      3) backup; read -r -p "Enter..." ;;
      4) restore; read -r -p "Enter..." ;;
      5) update_plugins; read -r -p "Enter..." ;;
      6) exec zsh ;;
      7) read -r -p "واقعاً حذف شود؟ [y/N] " a; [[ "$a" =~ ^[Yy]$ ]] && uninstall; read -r -p "Enter..." ;;
      0) exit 0 ;;
    esac
  done
}

case "${1:-menu}" in
  doctor) doctor ;;
  backup) backup ;;
  restore) restore ;;
  update) update_plugins ;;
  uninstall) uninstall ;;
  menu) menu ;;
  *) echo "Usage: ttermux [doctor|backup|restore|update|uninstall|menu]" ;;
esac
